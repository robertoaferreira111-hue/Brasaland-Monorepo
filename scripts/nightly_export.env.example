# Copy this file outside the repository before use, for example:
#   mkdir -p "$HOME/.config/brasaland"
#   cp scripts/nightly_export.env.example "$HOME/.config/brasaland/nightly_export.env"
# Edit only the copy. Do not commit real credentials.
#
# PATH must include the directory that contains the uv executable.
# DATABASE_URL is the non-production Postgres URL used by the nightly script
# and by data/pipelines/pipeline.py.

DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/brasaland
PATH=/usr/bin:/bin:/usr/sbin:/sbin:/absolute/path/to/directory/containing/uv

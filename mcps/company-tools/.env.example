# Copy into `.env` in this directory. Do not commit `.env`.
# Startup fails until every required value below is set.
# Streamable HTTP is the only transport this server starts.

MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8080

# Live incidents API. The token is a staff access token for that API.
INCIDENTS_API_BASE_URL=http://127.0.0.1:8000
INCIDENTS_API_TIMEOUT_SECONDS=5
INCIDENTS_API_TOKEN=

# OIDC issuer used by mcpauth. Audience is the JWT `aud` claim.
# Resource is the protected-resource identifier.
# Incidents and inventory each have one scope. A token for one does not grant the other.
MCP_AUTH_ISSUER=
MCP_AUTH_AUDIENCE=
MCP_AUTH_RESOURCE=
MCP_AUTH_SCOPES=
MCP_AUTH_INCIDENTS_SCOPE=
MCP_AUTH_INVENTORY_SCOPE=

# Optional. There is no inventory HTTP route in this repository yet.
# When the URL is set, the timeout is required too.
INVENTORY_API_BASE_URL=
INVENTORY_API_TIMEOUT_SECONDS=

# Copy secrets into an ignored local file (either path works):
#   cp .env.example .env
#   # or: mkdir -p .env && cp .env.example .env/local
# Never commit real API keys.

# --- Docker Compose ports ---
# Browser URLs:
#   website   http://localhost:3000
#   backoffice http://localhost:3001
#   talent    http://localhost:3002
#   API       http://localhost:8000
WEBSITE_PORT=3000
BACKOFFICE_PORT=3001
TALENT_PORT=3002
API_PORT=8000

# --- Redis queue ---
# DB index 0 is the queue and must not be shared with a cache.
# Host processes (the API and the Celery worker): redis://localhost:6379/0
# Processes inside Compose: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# This value is used by browser-side JavaScript and must therefore use the
# host-published API URL, not the Compose-only http://api:8000 hostname.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Auth / JWT ---
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# Password-reset tokens expire in 15–60 minutes (assignment window).
# Raw tokens are emailed once; only SHA-256 hashes are stored in TinyDB.
RESET_TOKEN_EXPIRE_MINUTES=30

# --- Frontend ---
# Base URL used to build the reset link sent by email:
#   {FRONTEND_URL}/reset-password?token=TOKEN_VALUE
# Backoffice is intended on 3001; public website on 3000.
FRONTEND_URL=http://localhost:3001

# --- Email provider (choose ONE) ---
# Preferred: Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Optional alternative: SendGrid
# SENDGRID_API_KEY=

# From address for transactional emails (must be allowed by your provider).
# Resend test sender: onboarding@resend.dev
EMAIL_FROM=Brasaland <onboarding@resend.dev>

# --- Supabase telemetry (server-side only; never expose to the browser) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for the business performance pipeline.
# Read by services/api settings and used only from data/pipelines/db.py.
# Leave empty until a non-production database is confirmed. Example:
#   postgresql://postgres:postgres@127.0.0.1:5432/brasaland
DATABASE_URL=

# --- RAG / Qdrant ---
# Host processes, including data/process/rag.py setup():
#   http://127.0.0.1:6333
# The API container receives http://qdrant:6333 from docker-compose.yml.
QDRANT_URL=http://127.0.0.1:6333

# OpenAI-compatible embeddings API. EMBEDDING_BASE_URL includes /v1 and does
# not include /embeddings. EMBEDDING_MODEL is the 4Geeks embedding model and
# must be a different id from GENERATION_MODEL. Leave the key empty until the
# platform key is available. Example base URL: https://api.openai.com/v1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Optional. When empty, setup() uses the length of the returned vector.
EMBEDDING_DIMENSION=

# Must be a different id from EMBEDDING_MODEL. generate_answer() calls this model.
# When GENERATION_BASE_URL and GENERATION_API_KEY are empty, those calls use the embedding base URL and key.
GENERATION_MODEL=

# --- Support agent: incident tools through MCP ---
# Streamable HTTP URL of the company-tools server, including /mcp.
# MCP_ACCESS_TOKEN is the OAuth bearer for that server. It is not the staff
# token the MCP server uses for the incidents API.
MCP_SERVER_URL=http://127.0.0.1:8080/mcp
MCP_ACCESS_TOKEN=
MCP_CLIENT_TIMEOUT_SECONDS=15

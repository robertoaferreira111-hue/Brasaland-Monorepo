# Copy secrets into an ignored local file (either path works):
#   cp .env.example .env
#   # or: mkdir -p .env && cp .env.example .env/local
# Never commit real API keys.

# --- Docker Compose ports ---
# Browser URLs:
#   website   http://localhost:3000
#   backoffice http://localhost:3001
#   talent    http://localhost:3002
#   API       http://localhost:8000
WEBSITE_PORT=3000
BACKOFFICE_PORT=3001
TALENT_PORT=3002
API_PORT=8000

# This value is used by browser-side JavaScript and must therefore use the
# host-published API URL, not the Compose-only http://api:8000 hostname.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Auth / JWT ---
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# Password-reset tokens expire in 15–60 minutes (assignment window).
# Raw tokens are emailed once; only SHA-256 hashes are stored in TinyDB.
RESET_TOKEN_EXPIRE_MINUTES=30

# --- Frontend ---
# Base URL used to build the reset link sent by email:
#   {FRONTEND_URL}/reset-password?token=TOKEN_VALUE
# Backoffice is intended on 3001; public website on 3000.
FRONTEND_URL=http://localhost:3001

# --- Email provider (choose ONE) ---
# Preferred: Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Optional alternative: SendGrid
# SENDGRID_API_KEY=

# From address for transactional emails (must be allowed by your provider).
# Resend test sender: onboarding@resend.dev
EMAIL_FROM=Brasaland <onboarding@resend.dev>

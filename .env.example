# Copy to .env for local or VPS use:  cp .env.example .env
# Never commit .env. Values below are placeholders only.

# Host port mappings → container ports 3000 / 3001 / 8000
UI_WEBSITE_PORT=3000
UI_BACKOFFICE_PORT=3001
API_PORT=8000

# Compose-internal API URL (service name + internal port). Used by containers on brasaland-net.
API_INTERNAL_URL=http://api:8000

# FastAPI auth (set a long random value on the VPS; never commit the real value)
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# Extra browser origins allowed by CORS (comma-separated). Required on VPS when UIs
# are opened via the server IP/hostname, e.g.:
#   CORS_ORIGINS=http://YOUR_VPS_IP:3000,http://YOUR_VPS_IP:3001
# Leave empty for local-only defaults (localhost / 127.0.0.1).
CORS_ORIGINS=

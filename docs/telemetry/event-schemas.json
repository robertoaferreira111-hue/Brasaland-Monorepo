{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brasaland.local/docs/telemetry/event-schemas.json",
  "title": "Brasaland Telemetry Event Schemas",
  "description": "JSON Schema draft-07 catalog for Brasaland inventory telemetry. Companion to docs/telemetry/telemetry-plan.md. Mandatory metrics from company-BRIEFING/brasaland-BRIEFING.md. Custom catalog keys use the x- prefix.",
  "x-schemaVersion": "1.0.0",
  "definitions": {
    "iso8601Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "country": {
      "type": "string",
      "enum": [
        "CO",
        "US"
      ]
    },
    "currency": {
      "type": "string",
      "enum": [
        "COP",
        "USD"
      ]
    },
    "productCategory": {
      "type": "string",
      "enum": [
        "protein",
        "vegetable",
        "sauce",
        "beverage",
        "packaging",
        "cleaning"
      ]
    },
    "unit": {
      "type": "string",
      "enum": [
        "kg",
        "unit",
        "liter"
      ]
    },
    "wasteReason": {
      "type": "string",
      "enum": [
        "expired",
        "kitchen_error",
        "theft_suspected"
      ]
    },
    "httpMethod": {
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ]
    },
    "opsPage": {
      "type": "string",
      "enum": [
        "login",
        "inbound_orders",
        "outbound_orders",
        "stock",
        "products",
        "suppliers",
        "account"
      ]
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "timestamp",
        "sessionId",
        "userId",
        "event_type",
        "entity_action",
        "schemaVersion",
        "requestId",
        "properties"
      ],
      "properties": {
        "eventId": {
          "$ref": "#/definitions/uuid",
          "description": "Unique id per emission"
        },
        "timestamp": {
          "$ref": "#/definitions/iso8601Timestamp"
        },
        "sessionId": {
          "$ref": "#/definitions/uuid",
          "description": "Opaque session id; never an email"
        },
        "userId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Opaque staff user id; null only for pre-auth events"
        },
        "event_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)+$",
          "description": "Stable event name in entity_action form"
        },
        "entity_action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)+$",
          "description": "Must equal event_type; explicit entity_action naming field"
        },
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "requestId": {
          "$ref": "#/definitions/uuid"
        },
        "properties": {
          "type": "object",
          "description": "Allowlisted event payload only"
        }
      }
    },
    "countryCurrencyConsistent": {
      "description": "Briefing \u00a76: amounts use location local currency \u2014 CO\u2192COP, US\u2192USD. No FX conversion in telemetry.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "country",
            "currency"
          ],
          "properties": {
            "country": {
              "const": "CO"
            },
            "currency": {
              "const": "COP"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "country",
            "currency"
          ],
          "properties": {
            "country": {
              "const": "US"
            },
            "currency": {
              "const": "USD"
            }
          }
        }
      ]
    }
  },
